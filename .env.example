# Configuración web de Firebase.
#
# Copiá este archivo a .env.local y completalo con los valores de tu proyecto
# (Firebase Console > Configuración del proyecto > Tus apps > Web).
#
# .env.local está en .gitignore y no se versiona.
#
# Estos valores NO son secretos: viajan en el bundle del cliente por diseño.
# Lo que protege la base son las reglas de seguridad (ver firestore.rules),
# no el ocultamiento de esta configuración.
#
# Si dejás esto sin completar, la aplicación funciona igual leyendo los
# desarrollos del repositorio local. Firestore es una mejora, no un requisito.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# Apunta el panel a los emuladores locales en vez de a tu proyecto real.
# Se usa solo en desarrollo: permite probar autenticación y escrituras sin
# tocar datos de producción y sin necesidad de credenciales.
VITE_USE_EMULATORS=
